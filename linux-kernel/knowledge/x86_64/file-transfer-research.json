  "observations": [
    {
      "id": "LK-X64-DIRENT-COPY-001",
      "path": "fs/readdir.c",
      "line_start": 341,
      "line_end": 382,
      "fact": "filldir64 derives the aligned record length and checks remaining capacity before using the destination for that record."
    },
    {
      "id": "LK-X64-DIRENT-EOF-001",
      "path": "fs/readdir.c",
      "line_start": 384,
      "line_end": 415,
      "fact": "getdents64 checks descriptor liveness before iteration. It writes the final cookie only after a record was emitted. EOF without records does not access the destination. Linux can return a completed prefix when a later copy fails."
    },
    {
      "id": "LK-X64-READ-RANGE-001",
      "path": "fs/read_write.c",
      "line_start": 554,
      "line_end": 582,
      "fact": "vfs_read checks mode and the requested address range before delegating to the file operation that can report EOF. The range check does not translate or write any destination byte."
    },
    {
      "id": "LK-X64-READ-RANGE-002",
      "path": "arch/x86/include/asm/uaccess_64.h",
      "line_start": 98,
      "line_end": 107,
      "fact": "The variable-size range check compares the unsigned sum of the address and count against USER_PTR_MAX and rejects wraparound."
    },
    {
      "id": "LK-X64-READ-RANGE-003",
      "path": "arch/x86/kernel/cpu/common.c",
      "line_start": 2642,
      "line_end": 2650,
      "fact": "The x86-64 boot code sets USER_PTR_MAX from TASK_SIZE_MAX. The alternative LAM assignment is commented out in this release."
    },
    {
      "id": "LK-X64-READ-RANGE-004",
      "path": "arch/x86/include/asm/page_64.h",
      "line_start": 138,
      "line_end": 149,
      "fact": "For four-level x86-64 paging task_size_max is (1 << 47) minus one page."
    }
  ],
  "scope": "Source evidence for bounded directory transfers and the independent read range check. The owned profile retains its complete-record copy contract."
